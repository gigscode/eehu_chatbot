# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# --- App ---
# "development" | "production" | "test"
# Set automatically by Next.js. Override only if you need to force a specific mode.
# NODE_ENV=development

# --- Analytics (Vercel) ---
# Injected automatically on Vercel. Add here only for self-hosted or local testing.
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# --- Chat backend (future) ---
# Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends this as a Bearer token to protect the keepalive route.
CRON_SECRET=

# API base URL for the eehu! chat service.
# NEXT_PUBLIC_EEHU_API_URL=https://api.eehu.io
# EEHU_API_SECRET=
